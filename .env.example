# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Self-hosted (Supabase running on the same machine via `npx supabase start`):
# the browser reaches Supabase through this app at /supabase, so only one port is exposed.
# NEXT_PUBLIC_SUPABASE_URL=/supabase
# SUPABASE_INTERNAL_URL=http://127.0.0.1:54321
